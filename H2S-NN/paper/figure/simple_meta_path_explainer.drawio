165" width="290" height="56" as="geometry"/></mxCell><mxCell id="ex1_title" parent="1" value="Example A: A-M-A" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111827;" vertex="1"><mxGeometry x="485" y="250" width="170" height="24" as="geometry"/></mxCell><mxCell id="ex1_desc" parent="1" value="Two actors are connected because they appear in the same movie." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#374151;whiteSpace=wrap;" vertex="1"><mxGeometry x="485" y="274" width="330" height="36" as="geometry"/></mxCell><mxCell id="ex1_aL" parent="1" value="Actor" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="510" y="325" width="56" height="56" as="geometry"/></mxCell><mxCell id="ex1_m" parent="1" value="Movie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="620" y="332" width="72" height="42" as="geometry"/></mxCell><mxCell id="ex1_aR" parent="1" value="Actor" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="750" y="325" width="56" height="56" as="geometry"/></mxCell><mxCell id="ex1_e1" parent="1" value="acts in" style="endArrow=block;html=1;strokeWidth=2.3;strokeColor=#F97316;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" source="ex1_aL" target="ex1_m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ex1_e2" parent="1" value="features" style="endArrow=block;html=1;strokeWidth=2.3;strokeColor=#F97316;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" source="ex1_m" target="ex1_aR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ex1_note" parent="1" value="Semantic meaning: co-actors / shared movie" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#9A3412;" vertex="1"><mxGeometry x="535" y="385" width="250" height="20" as="geometry"/></mxCell><mxCell id="ex2_title" parent="1" value="Example B: A-M-D" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111827;" vertex="1"><mxGeometry x="485" y="425" width="170" height="24" as="geometry"/></mxCell><mxCell id="ex2_desc" parent="1" value="An actor is connected to a director through a movie." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#374151;whiteSpace=wrap;" vertex="1"><mxGeometry x="485" y="448" width="330" height="30" as="geometry"/></mxCell><mxCell id="ex2_a" parent="1" value="Actor" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="530" y="480" width="56" height="56" as="geometry"/></mxCell><mxCell id="ex2_m" parent="1" value="Movie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="640" y="487" width="72" height="42" as="geometry"/></mxCell><mxCell id="ex2_d" parent="1" value="Director" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="770" y="478" width="62" height="62" as="geometry"/></mxCell><mxCell id="ex2_e1" parent="1" value="acts in" style="endArrow=block;html=1;strokeWidth=2.3;strokeColor=#8B5CF6;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" source="ex2_a" target="ex2_m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ex2_e2" parent="1" value="directed by" style="endArrow=block;html=1;strokeWidth=2.3;strokeColor=#8B5CF6;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" source="ex2_m" target="ex2_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="takeaway" parent="1" value="Key idea: a meta-path does not mean only one exact path.&lt;br&gt;It is a reusable &lt;b&gt;type-level pattern&lt;/b&gt; used to express semantic relations in heterogeneous graphs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.2;arcSize=10;fontSize=14;fontColor=#312E81;" vertex="1"><mxGeometry x="120" y="530" width="640" height="58" as="geometry"/></mxCell>
