  <diagram id="meta-path-01" name="Page-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" value="Meta-path in a Heterogeneous Graph" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111827;" vertex="1"><mxGeometry x="210" y="20" width="520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" value="A meta-path is a sequence of node types and relation types that describes a semantic connection." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4B5563;whiteSpace=wrap;" vertex="1"><mxGeometry x="120" y="55" width="700" height="34" as="geometry"/></mxCell><mxCell id="left_panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=10;" vertex="1"><mxGeometry x="40" y="110" width="360" height="400" as="geometry"/></mxCell><mxCell id="left_head" parent="1" value="1) Example heterogeneous network" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1"><mxGeometry x="80" y="125" width="280" height="28" as="geometry"/></mxCell><mxCell id="legend_types" parent="1" value="Node types" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#111827;" vertex="1"><mxGeometry x="65" y="160" width="100" height="24" as="geometry"/></mxCell><mxCell id="ls1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="75" y="187" width="16" height="16" as="geometry"/></mxCell><mxCell id="lt1" parent="1" value="Actor" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#374151;whiteSpace=wrap;" vertex="1"><mxGeometry x="95" y="185" width="50" height="20" as="geometry"/></mxCell><mxCell id="ls2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1"><m