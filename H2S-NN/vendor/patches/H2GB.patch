diff --git a/H2GB/datasets/ieee_cis_dataset.py b/H2GB/datasets/ieee_cis_dataset.py
index 5abec95..838b70e 100644
--- a/H2GB/datasets/ieee_cis_dataset.py
+++ b/H2GB/datasets/ieee_cis_dataset.py
@@ -187,6 +187,15 @@ class IeeeCisDataset(InMemoryDataset):
         test_transaction_df = pd.read_csv(self.raw_paths[2])
         test_identity_df = pd.read_csv(self.raw_paths[3])
 
+        # The official Kaggle files name identity columns inconsistently: train_identity.csv
+        # uses id_01..id_38, test_identity.csv uses id-01..id-38. Left as-is, concatenation
+        # keeps both as separate columns, each populated only for its own split (the other
+        # half NaN), and the id-* columns (some categorical, e.g. id-30 "Windows 10") are not
+        # recognized by DEFAULT_TARGET_CAT_FEAT_COLS (which only lists the id_* spelling),
+        # so they leak into the "numeric" columns below and break torch.tensor(...).
+        test_identity_df = test_identity_df.rename(
+            columns={c: c.replace('id-', 'id_') for c in test_identity_df.columns if c.startswith('id-')})
+
         transaction_df = pd.concat([train_transaction_df, test_transaction_df], axis=0)
         identity_df = pd.concat([train_identity_df, test_identity_df], axis=0)
         transaction_df = pd.merge(transaction_df, identity_df, on="TransactionID")
